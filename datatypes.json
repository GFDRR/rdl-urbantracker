[{% for datatype in site.datatypes %}
  {
    "category": {{ datatype.category | jsonify }},
    "id": {{ datatype.id | jsonify }},  
    "title": {{ datatype.title | jsonify }}{% if datatype.description != "" %},
    "description": {{ datatype.description | jsonify }}{% endif %}{% if datatype.example_indicators != "" %},
    "example_indicators": {{ datatype.example_indicators | jsonify }}{% endif %}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
